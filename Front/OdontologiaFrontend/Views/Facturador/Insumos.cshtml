
@{
    ViewBag.Title = "Insumos";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- HEADER -->
<header>
    <div class="jumbotron text-center p-4 bannerInsumos text-white rounded-0">
        <h1 class="display-2 titulo-elegante">@ViewBag.Title</h1>
        <hr class="border border-info">
    </div>
</header>

<div class="container-fluid mb-3">
    <div class="row">
        <div class="col-md-12">
            <table class="table table-striped table-bordered" id="tbinsumos" style="width:100%">
                <thead class="thead-dark">
                    <tr>
                        <th scope="col">userId</th>
                        <th scope="col">title</th>
                        <th scope="col">body</th>
                        <th scope="col">Accion</th>
                    </tr>
                </thead>
            </table>
        </div>
    </div>
</div>

<!-- Modal de Aprobar Compra de Insumo -->
<div class="modal fade bd-example-modal-lg" id="modalInput" tabindex="-1" role="dialog" aria-labelledby="myLargeModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered" role="document">
        <div class="modal-content">
            <h3 class="text-center p-2">Formulario de Aprobacion</h3>
            ...
        </div>
    </div>
</div>

@section scripts{
    <script src="~/Scripts/js/Facturador/insumos.js"></script>
}