
@{
    ViewBag.Title = "Facturador";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- HEADER -->
<header class="p-0">
    <div class="jumbotron text-center p-4">
        <h1 class="display-5">Bienvenido, @ViewBag.Title</h1>
        <h4>
            Resumen disponible del dia @DateTime.Now
        </h4>
        <hr class="border border-info">
    </div>
</header>

<div class="container-fluid">
    <div class="row">
        <div class="col-md-6 text-center">
            <div class="card p-3 m-3 card-consultas">
                <div class="card-body">
                    <img src="https://centauro.com.mx/wp-content/uploads/9-preguntas-frecuentes-sobre-ir-al-dentista.jpg" alt="..." class="img-thumbnail">
                    <h5 class="card-title">Consultas</h5>
                    <p class="card-text">With supporting text below as a natural lead-in to additional content.</p>
                    <a href="@Url.Action("Consultas","Facturador")" class="btn btn-primary">Ver Consultas</a>
                </div>
            </div>
        </div>
        <div class="col-md-6 text-center">
            <div class="card p-3 m-3">
                <div class="card-body">
                    <img src="https://img.freepik.com/foto-gratis/pagina-inicio-conexion-portatil-documentos-envio_53876-138115.jpg?size=626&ext=jpg&ga=GA1.1.961867392.1697068800&semt=ais" alt="..." class="img-thumbnail">
                    <h5 class="card-title">Facturas</h5>
                    <p class="card-text">With supporting text below as a natural lead-in to additional content.</p>
                    <a href="@Url.Action("Facturas","Facturador")" class="btn btn-primary">Ver Facturas</a>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- footer -->
<footer class="bg-dark p-3">
    <p>
        Frontend: Jesús Morales
        <a href="#">
            <span class="material-symbols-outlined">
                home_pin
            </span>
        </a>
        Backend: Douglas Worm
        <a href="#">
            <span class="material-symbols-outlined">
                home_pin
            </span>
        </a>
        DataBase: Luís Delgado <a href="#">
            <span class="material-symbols-outlined">
                home_pin
            </span>
        </a>
    </p>
</footer>