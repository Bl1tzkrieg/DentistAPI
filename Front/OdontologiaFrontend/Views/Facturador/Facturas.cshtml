
@{
    ViewBag.Title = "Facturas";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- HEADER -->
<header>
    <div class="jumbotron text-center p-4 bannerFacturas text-white rounded-0">
        <h1 class="display-2 titulo-elegante">@ViewBag.Title</h1>
        <hr class="border border-info">
    </div>
</header>

<div class="container-fluid mb-3">
    <div class="btn-group mb-2" role="group" aria-label="Basic example">
        <button type="button" class="btn btn-primary">Ventas</button>
        <button type="button" class="btn btn-success">Compras</button>
    </div>
    <div class="row">
        <div class="col-md-12">
            <table class="table table-striped table-bordered" id="tbfacturas" style="width:100%">
                <thead class="thead-dark">
                    <tr>
                        <th scope="col">userId</th>
                        <th scope="col">title</th>
                        <th scope="col">body</th>
                        <th scope="col">Accion</th>
                    </tr>
                </thead>
            </table>
        </div>
    </div>
</div>


@section scripts{
    <script src="~/Scripts/js/Facturador/facturas.js"></script>
}