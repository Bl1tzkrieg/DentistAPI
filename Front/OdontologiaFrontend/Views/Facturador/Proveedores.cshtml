
@{
    ViewBag.Title = "Lista De Proveedores";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- HEADER -->
<header>
    <div class="jumbotron text-center p-4 bannerProveedores text-white rounded-0">
        <h1 class="display-2 titulo-elegante">@ViewBag.Title</h1>
        <hr class="border border-info">
    </div>
</header>


<div class="container-fluid mb-3">
    <div class="row">
        <div class="col-md-12">
            <table class="table table-striped table-bordered" id="tbproveedores" style="width:100%">
                <thead class="thead-dark">
                    <tr>
                        <th scope="col">userId</th>
                        <th scope="col">title</th>
                        <th scope="col">body</th>
                        <th scope="col">Accion</th>
                    </tr>
                </thead>
            </table>
        </div>
    </div>
</div>



@section scripts{
    <script src="~/Scripts/js/Facturador/proveedores.js"></script>
}