
@{
    ViewBag.Title = "Consultas";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- HEADER -->
<header>
    <div class="jumbotron text-center p-4 bannerConsultas text-white rounded-0">
        <h1 class="display-2 titulo-elegante">@ViewBag.Title</h1>
        <hr class="border border-info">
    </div>
</header>

<div class="container-fluid mb-3">
    <div class="row">
        <div class="col-md-12">
            <div class="alert alert-success text-center" role="alert">
                A simple success alert—check it out!
            </div>
            <!-- Button trigger modal -->
            <button type="button" class="btn btn-primary mb-1" data-toggle="modal" data-target="#exampleModalCenter">
                Registrar Nueva Cita
            </button>
            <table class="table table-striped table-bordered" id="tbconsultas" style="width:100%">
                <thead class="thead-dark">
                    <tr>
                        <th scope="col">userId</th>
                        <th scope="col">title</th>
                        <th scope="col">body</th>
                        <th scope="col">Accion</th>
                    </tr>
                </thead>
            </table>
        </div>
    </div>
</div>

<!-- Modal para busqueda de persona -->
<div class="modal fade modalConsulta" id="exampleModalCenter" tabindex="-1" role="dialog" aria-labelledby="exampleModalCenterTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalCenterTitle">Consultar Persona</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <p>Ingrese el numero de cedula</p>
                <div class="input-group mb-3">
                    <input type="text" id="input_id" class="form-control" placeholder="V-123456789" aria-label="Recipient's username" aria-describedby="button-addon2">
                    <div class="input-group-append">
                        <button class="btn btn-primary" type="button" id="btnConsultar">Consultar</button>
                    </div>
                </div>
                <div class="alert alert-warning" role="alert">
                    Ingrese numero de cedula por favor!
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal para registro de cita -->
<div class="modal fade modalRegistro" id="exampleModalCenter" tabindex="-1" role="dialog" aria-labelledby="exampleModalCenterTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalCenterTitle">Formulario de Cita</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <form class="p-4" action="#" method="post">
                    <div class="form-row">
                        <div class="form-group col-md-6">
                            <input type="text" class="form-control" placeholder="First Name" required>
                        </div>
                        <div class="form-group col-md-6">
                            <input type="text" class="form-control" placeholder="Second Name" required>
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="form-group col-md-6">
                            <input type="text" class="form-control" placeholder="V-12345678" required>
                        </div>
                        <div class="form-group col-md-6">
                            <input type="text" class="form-control" placeholder="####-#######" required>
                        </div>
                    </div>
                    <div class="form-group">
                        <input type="email" class="form-control" placeholder="Email Address example@mail.com" required>
                    </div>
                    <div class="form-group">
                        <label>Fecha De Nacimiento</label>
                        <input type="date" class="form-control" required>
                    </div>
                    <div class="form-group">
                        <label>Fecha De Consulta</label>
                        <input type="datetime-local" class="form-control" required>
                    </div>
                    <div class="input-group mb-3">
                        <div class="input-group-prepend">
                            <label class="input-group-text" for="inputGroupSelect01">Doctor</label>
                        </div>
                        <select class="custom-select" id="inputGroupSelect01">
                            <option selected>Choose...</option>
                            <option value="1">One</option>
                            <option value="2">Two</option>
                            <option value="3">Three</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="exampleFormControlTextarea1">Descripción</label>
                        <textarea class="form-control" id="exampleFormControlTextarea1" rows="3" style="resize:none;" required></textarea>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                        <input type="submit" class="btn btn-primary" value="Guardar" />
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>


@section scripts{
    <script src="~/Scripts/js/Dentista/consultas.js"></script>
}