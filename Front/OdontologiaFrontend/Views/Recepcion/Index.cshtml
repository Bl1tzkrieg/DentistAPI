
@{
    ViewBag.Title = "Recepcion";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- HEADER -->
<header class="p-0">
    <div class="jumbotron text-center p-4">
        <h1 class="display-5">Bienvenido, @ViewBag.Title</h1>
        <h4>
            Resumen disponible del dia @DateTime.Now
        </h4>
        <hr class="border border-info">
    </div>
</header>

<div class="container-fluid">
    <div class="row justify-content-center">
        <div class="col-xl-6 text-center">
            <div class="card p-3">
                <div class="card-body p-0">
                    <img src="https://img.freepik.com/foto-gratis/hermosa-chica-sentada-oficina-dentista_1157-19478.jpg?size=626&ext=jpg&ga=GA1.1.386372595.1696377600&semt=ais" alt="..." class="img-thumbnail">
                    <h5 class="card-title">Consultas</h5>
                    <p class="card-text">With supporting text below as a natural lead-in to additional content.</p>
                    <a href="@Url.Action("Consultas","Recepcion")" class="btn btn-primary">Ver Consultas</a>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- footer -->
<footer class="bg-dark p-3">
    <p>Frontend: Jesús Morales 
    <a href="#"><span class="material-symbols-outlined">
    home_pin
    </span></a> 
     Backend: Douglas Worm 
    <a href="#">
        <span class="material-symbols-outlined">
            home_pin
        </span>
    </a>
    DataBase: Luís Delgado <a href="#">
    <span class="material-symbols-outlined">
        home_pin
    </span>
</a></p>
</footer>

