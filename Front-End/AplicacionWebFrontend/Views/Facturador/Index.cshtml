
@{
    ViewBag.Title = "Facturador";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<main>
    <!-- HEADER -->
    <header class="m-3 rounded-2 text-white shadow" style="background: linear-gradient(to right, #ffcc00 0%, #cc6600 100%); ">
        <div class="jumbotron text-center p-4">
            <h1 class="display-5">Bienvenido, @ViewBag.Title!</h1>
            <h4>
                Resumen disponible del dia @DateTime.Now.ToString("D")
            </h4>
            <hr class="border border-info" style="background-color:#222">
        </div>
    </header>

    <div class="container-fluid">
        <div class="row row-cols-1 row-cols-md-2">
            <div class="col p-4">
                <div class="card shadow">
                    <img src="https://centauro.com.mx/wp-content/uploads/9-preguntas-frecuentes-sobre-ir-al-dentista.jpg" class="card-img-top" alt="...">
                    <div class="card-body text-center">
                        <h5 class="card-title">Consultas</h5>
                        <p class="card-text">Resumen de todas las cunsultas pendientes por facturar</p>
                        <a href="@Url.Action("Consultas","Facturador")" class="btn btn-outline-primary">Ver Consultas</a>
                    </div>
                </div>
            </div>
            <div class="col p-4">
                <div class="card shadow">
                    <img src="https://img.freepik.com/foto-gratis/pagina-inicio-conexion-portatil-documentos-envio_53876-138115.jpg?size=626&ext=jpg&ga=GA1.1.961867392.1697068800&semt=ais" class="card-img-top" alt="...">
                    <div class="card-body text-center">
                        <h5 class="card-title">Ventas</h5>
                        <p class="card-text">Resumen de ventas.</p>
                        <a href="@Url.Action("Ventas","Facturador")" class="btn btn-outline-success">Ver Facturas</a>
                    </div>
                </div>
            </div>
            <div class="col p-4">
                <div class="card shadow">
                    <img src="https://www.odontoimport.cl/docs/productos/Cat_138183901890.jpg" class="card-img-top" alt="...">
                    <div class="card-body text-center">
                        <h5 class="card-title">Insumos</h5>
                        <p class="card-text">Resumen de Insumos</p>
                        <a href="@Url.Action("Insumos","Facturador")" class="btn btn-outline-warning">Ver Insumos</a>
                    </div>
                </div>
            </div>
            <div class="col p-4">
                <div class="card shadow">
                    <img src="https://retos-operaciones-logistica.eae.es/wp-content/uploads/2016/12/proveedores-600x400.jpg" class="card-img-top" alt="...">
                    <div class="card-body text-center">
                        <h5 class="card-title">Compras</h5>
                        <p class="card-text">Resumen de Compras</p>
                        <a href="@Url.Action("Compras","Facturador")" class="btn btn-outline-info">Ver Compras</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</main>
