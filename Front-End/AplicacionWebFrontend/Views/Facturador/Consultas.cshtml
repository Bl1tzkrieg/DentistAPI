
@{
    ViewBag.Title = "Consultas";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<main>

    <header class="m-3 rounded-2 text-white shadow" style="background: linear-gradient(to right, #ffcc00 0%, #cc6600 100%);">
        <div class="jumbotron text-center p-4">
            <h1 class="display-5">@ViewBag.Title Por Facturar!</h1>
            <hr class="border border-info" style="background-color:#222">
        </div>
    </header>

    <div class="m-3 d-flex justify-content-around flex-wrap">
        <div class="card m-3 text-center p-3 bg-warning bg-opacity-10 border border-warning rounded-end" style="width: 30rem;">
            <div class="card-body">
                <h3 class="card-title">Consultas Por Facturar</h3>
                <h4 class="card-text" id="consultas_por_facturar">0</h4>
            </div>
        </div>
        <div class="card m-3 text-center p-3 bg-success bg-opacity-10 border border-success rounded-end" style="width: 30rem;">
            <div class="card-body">
                <h3 class="card-title">Consultas Facturadas</h3>
                <h4 class="card-text" id="consultas_facturadas">0</h4>
            </div>
        </div>
    </div>

    <div class="alert alert-danger mx-3 text-center" role="alert" id="alerta_error" style="display:none;">
        <h4 class="alert-heading">Ups, We have a problem Error 500!</h4>
    </div>

    <div class="m-3 rounded-2 shadow p-3" id="tabla">
        <table class="table table-striped compact responsive" cellspacing="0" style="width:100%" id="tbconsultas">
            <thead class="table-primary">
                <tr>
                    <th scope="col" colspan="1">Id-Consulta</th>
                    <th scope="col" colspan="1">Cedula Cliente</th>
                    <th scope="col" colspan="1">Nombre</th>
                    <th scope="col" colspan="1">Apellido</th>
                    <th scope="col" colspan="1">Registrado por</th>
                    <th scope="col" colspan="1">Estado de la consulta</th>
                    <th scope="col" colspan="1">Facturar/Cancelar</th>
                </tr>
            </thead>
        </table>
    </div>

    <!-- Modal de registor de consulta -->
    <div class="modal fade" id="modalFacturarConsulta" tabindex="-1" aria-labelledby="modalRegistroLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="modalRegistroLabel">Facturar consulta</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <form id="formularioFacturarConsulta">
                        <div class="mb-3">
                            <label for="cliente_cedula">Cliente Cedula</label>
                            <input type="text" class="form-control" id="cliente_cedula" disabled>
                            <input type="hidden" class="form-control" id="cliente_id">
                            <input type="hidden" class="form-control" id="consulta_id">
                            <label for="consulta_fecha">Fecha consulta</label>
                            <input type="text" class="form-control" id="consulta_fecha" disabled>
                        </div>
                        <div class="mb-3">
                            <label for="nombre_cliente">Nombre Cliente</label>
                            <input type="text" class="form-control" id="nombre_cliente" disabled>
                            <label for="apellido_cliente">Apellido Cliente</label>
                            <input type="text" class="form-control" id="apellido_cliente" disabled>
                        </div>
                        <div class="mb-3">
                            <label for="estatus_factura">Status Pago</label>
                            <input type="text" class="form-control" id="estatus_factura" disabled>
                            <label for="nombre_usuario">Consulta Registrada por</label>
                            <input type="text" class="form-control" id="nombre_usuario" disabled>
                        </div>
                        <div class="mb-3">
                            <label for="numero_factura">Numero referencia</label>
                            <input type="text" class="form-control" id="numero_factura" required>
                            <label for="monto">Monto total</label>
                            <input type="text" class="form-control" id="monto" required>
                        </div>
                        <div class="mb-3">
                            <label for="tipo_pago" class="form-label">Tipo De Pago</label>
                            <select class="form-select" id="tipo_pago" required>
                                <!-- Asegúrate de llenar las opciones con los pagos disponibles -->
                                <option value="1">Zelle</option>
                                <option value="2">PagoMovil</option>
                                <option value="3">Debito</option>
                                <option value="4">Efectivo</option>
                                <option value="5">Credito</option>
                            </select>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                            <button type="submit" class="btn btn-primary">Facturar</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

</main>

@section scripts{
    <script src="~/Scripts/js/methodsDatatables.js"></script>
    <script src="~/Scripts/js/Facturador/consultas.js"></script>
}