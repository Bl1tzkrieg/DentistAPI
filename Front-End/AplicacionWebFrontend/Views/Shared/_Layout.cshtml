<!DOCTYPE html>
<html lang="es">
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Mi aplicación ASP.NET</title>

    <script src="https://kit.fontawesome.com/290c606912.js" crossorigin="anonymous"></script>

    @Styles.Render("~/Content/css")
    @Styles.Render("~/Content/datatable/css")
    @Scripts.Render("~/bundles/modernizr")

    <!-- googlefonts -->
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@1&display=swap" rel="stylesheet">

    <!-- Estilos Css Layout -->
    <link href="~/Content/MyStyles/layout.css" rel="stylesheet" />

</head>
<body>
    <!-- Navigation -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark sticky-top">
        <div class="container-fluid">
            <a class="navbar-brand" href="@Url.Action("Index", Session["perfil"].ToString())">
                <img src="https://media.istockphoto.com/id/1196233488/es/vector/icono-dental-logotipo-de-la-plantilla-de-dise%C3%B1o-de-la-ilustraci%C3%B3n-vector-eps-10.jpg?s=612x612&w=0&k=20&c=AgxaQ6xdIsZJjgvqwGkpWAFErUWoPzqSE2MVyhZwu1E=" width="40" height="40" class="d-inline-block align-top border border-primary rounded-circle" alt="">
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarText" aria-controls="navbarText" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarText">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    @if (Session["perfil"].Equals("Admin"))
                    {
                        <li class="nav-item">
                            <a class="nav-link" href="@Url.Action("Consultas","Admin")">Consultas</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="@Url.Action("Compras","Admin")">Compras</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="@Url.Action("Ventas","Admin")">Ventas</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="@Url.Action("Usuarios","Admin")">Usuarios</a>
                        </li>
                    }

                    @if (Session["perfil"].ToString() == "Dentista")
                    {
                        <li class="nav-item">
                            <a class="nav-link" href="@Url.Action("Consultas","Dentista")">Consultas</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="@Url.Action("Insumos","Dentista")">Insumos</a>
                        </li>
                    }

                    @if (Session["perfil"].ToString() == "Facturador")
                    {
                        <li class="nav-item">
                            <a class="nav-link" href="@Url.Action("Consultas","Facturador")">Consultas</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="@Url.Action("Ventas","Facturador")">Ventas</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="@Url.Action("Compras","Facturador")">Compras</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="@Url.Action("Insumos","Facturador")">Insumos</a>
                        </li>
                    }

                    @if (Session["perfil"].ToString() == "Recepcion")
                    {
                        <li class="nav-item">
                            <a class="nav-link" href="@Url.Action("Consultas","Recepcion")">Consultas</a>
                        </li>
                    }
                </ul>
                <div class="dropdown navbar-text text-dark">
                    <div class="dropdown">
                        <a class="btn btn-secondary dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            User, @Session["perfil"].ToString()
                        </a>

                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item text-dark" href="@Url.Action("Cerrar","Acceso")">Salir</a></li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </nav>
    <!-- fin navegacion -->
    <!-- renderBody -->
    <div class="container-fluid p-0 contenido">
        @RenderBody()
    </div>

    <footer class="text-center text-white bg-black m-0 p-3">
        <p>
            Frontend: Jesús Morales
            <a href="#">
                <span class="material-symbols-outlined text-primary">
                    home_pin
                </span>
            </a>
            Backend: Douglas Worm
            <a href="#">
                <span class="material-symbols-outlined text-primary">
                    home_pin
                </span>
            </a>
            DataBase: Luís Delgado <a href="#">
                <span class="material-symbols-outlined text-primary">
                    home_pin
                </span>
            </a>
        </p>
    </footer>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @Scripts.Render("~/Content/datatable/js")
    @RenderSection("scripts", required: false)

</body>
</html>
