
@{
    ViewBag.Title = "Consultas";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<main>

    <header class="m-3 rounded-2 text-white shadow" style="background: linear-gradient(to right, #009999 0%, #00ccff 100%);">
        <div class="jumbotron text-center p-4">
            <h1 class="display-5">@ViewBag.Title!</h1>
            <hr class="border border-info" style="background-color:#222">
        </div>
    </header>

    <div class="container-fluid">
        <div>

        </div>
    </div>

    <div class="m-3 rounded-2 shadow p-3">
        <table class="table table-striped compact responsive" cellspacing="0" style="width:100%" id="tbconsultas">
            <thead class="table-primary">
                <tr>
                    <th scope="col" colspan="1">Id-Consulta</th>
                    <th scope="col" colspan="1">Cedula Cliente</th>
                    <th scope="col" colspan="1">Nombre</th>
                    <th scope="col" colspan="1">Apellido</th>
                    <th scope="col" colspan="1">Registrado por</th>
                    <th scope="col" colspan="1">Estado de la consulta</th>
                    <th scope="col" colspan="1">Actualizar/Cancelar</th>
                </tr>
            </thead>
        </table>
    </div>

    <!-- Modal para busqueda de cliente -->
    <div class="modal fade" id="modalBuscarCliente" tabindex="-1" aria-labelledby="modalBuscarEmpleadoLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h3 class="modal-title" id="modalBuscarClienteLabel">Indique el numero de cedula del cliente</h3>
                </div>
                <div class="modal-body">
                    <form>
                        <div class="mb-3">
                            <input type="text" class="form-control" id="identificacion" placeholder="Example V12345678">
                        </div>
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="button" class="btn btn-primary" id="buscarCli">Buscar Cliente</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal de registor de consulta -->
    <div class="modal fade" id="modalRegistroConsulta" tabindex="-1" aria-labelledby="modalRegistroLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="modalRegistroLabel">Registrar consulta</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <form id="formularioRegistroConsulta">
                        <div class="mb-3">
                            <label for="cedula_cliente">Cliente cedula</label>
                            <input type="text" class="form-control" id="cedula_cliente" name="idCliente" disabled>
                            <input type="hidden" class="form-control" id="cliente_id" name="idCliente">
                        </div>
                        <div class="mb-3">
                            <label for="fechaConsulta">Fecha consulta</label>
                            <input type="date" class="form-control" id="fechaConsulta" required>
                        </div>
                        <div class="form-floating mt-3">
                            <textarea class="form-control" required id="floatingTextarea2" style="height: 100px; resize:none;"></textarea>
                            <label for="floatingTextarea2">Descripcion de la consulta</label>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                            <button type="submit" class="btn btn-primary">Registrar</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal de actualizacion de consulta -->
    <div class="modal fade" id="modalUpdate" tabindex="-1" aria-labelledby="modalUpdateLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="modalRegistroLabel">Modificacion De Consulta</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <form id="formularioUpdate">
                        <div class="row">
                            <div class="col">
                                <label for="nombre">Nombre</label>
                                <input type="text" class="form-control" id="nombre" disabled>
                            </div>
                            <div class="col">
                                <label for="apellido">Apellido</label>
                                <input type="text" class="form-control" id="apellido" disabled>
                            </div>
                        </div>
                        <div class="row mt-3">
                            <div class="col">
                                <label for="cedula">Cedula</label>
                                <input type="text" id="cedula" class="form-control" disabled>
                            </div>
                            <div class="col">
                                <label for="registrado">Registrado por</label>
                                <input type="text" class="form-control" id="registrado" disabled>
                            </div>
                        </div>
                        <div class="row mt-3">
                            <div class="col">
                                <label for="estado">Estado Consulta</label>
                                <input type="text" class="form-control" id="estado" disabled>
                            </div>
                            <div class="col">
                                <label for="fecasig">Fecha de Consulta</label>
                                <input type="text" class="form-control" id="fecasig" disabled>
                            </div>
                        </div>
                        <div class="row mt-3">
                            <div class="col">
                                <label for="fecmod">Nueva fecha</label>
                                <input type="date" class="form-control" id="fecmod" required>
                            </div>
                            <div class="col">
                                <label for="fecemi">Fecha de Emision</label>
                                <input type="text" class="form-control" id="fecemi" disabled>
                            </div>
                            <div class="col">
                                <input type="hidden" value="" class="form-control" id="consulta_id">
                            </div>
                        </div>
                        <div class="form-floating mt-3">
                            <textarea class="form-control" id="textAreaUpdateQuery" style="height: 100px; resize:none;"></textarea>
                            <label for="textAreaUpdateQuery">Descripcion de la consulta</label>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                            <button type="submit" class="btn btn-primary">Actualizar</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

</main>

@section scripts{
    <script src="~/Scripts/js/methodsDatatables.js"></script>
    <script src="~/Scripts/js/Dentista/consultas.js"></script>
}

