
@{
    ViewBag.Title = "Insumos";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<main>

    <header class="m-3 rounded-2 text-white shadow" style="background: linear-gradient(to right, #009999 0%, #00ccff 100%);">
        <div class="jumbotron text-center p-4">
            <h1 class="display-5">@ViewBag.Title!</h1>
            <hr class="border border-info" style="background-color:#222">
        </div>
    </header>

    <div class="alert alert-danger mx-3 text-center" role="alert" id="alerta_error" style="display:none;">
        <h4 class="alert-heading">Ups, We have a problem Error 500!</h4>
    </div>

    <div class="m-3 rounded-2 shadow p-3" id="tabla">
        <table class="table table-striped compact responsive" cellspacing="0" style="width:100%" id="tbinsumos">
            <thead class="table-primary">
                <tr>
                    <th scope="col" colspan="1">Pedido Id</th>
                    <th scope="col" colspan="1">Cantidad</th>
                    <th scope="col" colspan="1">Descripción</th>
                    <th scope="col" colspan="1">Registrado Por</th>
                    <th scope="col" colspan="1">Fecha</th>
                    <th scope="col" colspan="1">Ver</th>
                </tr>
            </thead>
        </table>
    </div>

    <!-- Modal registro de insumo -->
    <div class="modal fade" id="modalRegistroInsumo" tabindex="-1" aria-labelledby="modalRegistroLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="modalRegistroLabel">Registrar Insumo</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <form id="formularioRegistroInsumo">
                        <div class="mb-3">
                            <input type="hidden" class="form-control" id="usuario_id">
                            <label for="cantidad">Cantidad</label>
                            <input type="number" min="1" max="100" class="form-control" id="cantidad" required>
                        </div>
                        <div class="form-floating mt-3">
                            <textarea class="form-control" required id="descripcion_pedido" style="height: 100px; resize:none;"></textarea>
                            <label for="descripcion_pedido">Descripcion del pedido</label>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                            <button type="submit" class="btn btn-primary">Registrar</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal update de insumo -->
    <div class="modal fade" id="modalUpdateInsumo" tabindex="-1" aria-labelledby="modalRegistroLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="modalRegistroLabel">Modificar Insumo</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <form id="formularioUpdateInsumo">
                        <div class="mb-3">
                            <input type="hidden" class="form-control" id="pedido_id_update">
                            <label for="username_update">Registrado por</label>
                            <input type="text" class="form-control" id="username_update" disabled>
                            <label for="fecha">Fecha de emision</label>
                            <input type="text" class="form-control" id="fecha" disabled>
                        </div>
                        <div class="mb-3">
                            <label for="cantidad_update">Cantidad</label>
                            <input type="number" min="1" max="100" class="form-control" id="cantidad_update" required>
                            <label for="estado">Estatus</label>
                            <input type="text" class="form-control" id="estado" disabled>
                        </div>
                        <div class="form-floating mt-3">
                            <textarea class="form-control" id="descripcion_pedido_update" style="height: 100px; resize:none;"></textarea>
                            <label for="descripcion_pedido_update">Descripcion del pedido</label>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                            <button type="submit" class="btn btn-primary">Actualizar</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>


</main>

@section scripts{
    <script src="~/Scripts/js/methodsDatatables.js"></script>
    <script src="~/Scripts/js/Dentista/insumos.js"></script>
}

