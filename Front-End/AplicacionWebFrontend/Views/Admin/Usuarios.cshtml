
@{
    ViewBag.Title = "Usuarios";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<main>

    <header class="m-3 rounded-2 text-white shadow" style="background: linear-gradient(to left, #003366 0%, #0099ff 100%);">
        <div class="jumbotron text-center p-4">
            <h1 class="display-5">@ViewBag.Title</h1>
            <hr class="border border-info" style="background-color:#222">
        </div>
    </header>

    <div class="m-3 rounded-2 shadow p-3">
        <table class="table table-striped responsive" cellspacing="0" style="width:100%" id="tbusuarios">
            <thead class="table-primary">
                <tr>
                    <th scope="col" colspan="1">ID</th>
                    <th scope="col" colspan="1">Usuario</th>
                    <th scope="col" colspan="1">Rol</th>
                    <th scope="col" colspan="1">Status</th>
                    <th scope="col" colspan="1">Ver</th>
                </tr>
            </thead>
        </table>
    </div>

    <!-- Modal -->
    <div class="modal fade" id="modalBuscarEmpleado" tabindex="-1" aria-labelledby="modalBuscarEmpleadoLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h3 class="modal-title" id="modalBuscarEmpleadoLabel">Ingrese el documento de identidad</h3>
                </div>
                <div class="modal-body">
                    <form>
                        <div class="mb-3">
                            <input type="text" class="form-control" id="identificacion" placeholder="Example V12345678">
                        </div>
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="button" class="btn btn-primary" id="buscarEmp">Buscar Empleado</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal de registor de usuario -->
    <div class="modal fade" id="modalRegistro" tabindex="-1" aria-labelledby="modalRegistroLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="modalRegistroLabel">Registro de Usuario</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <form id="formularioRegistro">
                        <div class="mb-3">
                            <label for="username" class="form-label">Nombre de usuario</label>
                            <input type="text" class="form-control" id="username" name="username" required>
                        </div>
                        <div class="mb-3">
                            <label for="password" class="form-label">Contraseña</label>
                            <input type="password" class="form-control" id="password" name="password" required>
                        </div>
                        <div class="mb-3">
                            <label for="repeatPassword" class="form-label">Repetir Contraseña</label>
                            <input type="password" class="form-control" id="repeatPassword" required>
                        </div>
                        <div class="mb-3">
                            <label for="rol_registro" class="form-label">Rol</label>
                            <select class="form-select" id="rol_registro" name="rol" required>
                                <option value="">Seleccione un rol</option>
                                <!-- Asegúrate de llenar las opciones con los roles disponibles -->
                                <option value="2">Dentista</option>
                                <option value="3">Facturador</option>
                                <option value="4">Recepcion</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label for="idEmpleado" class="form-label">ID Empleado</label>
                            <input type="text" class="form-control" id="idEmpleado" name="idEmpleado" disabled>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                            <button type="submit" class="btn btn-primary">Registrar</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal de actualizacion Usuario -->
    <div class="modal fade" id="modalUpdate" tabindex="-1" aria-labelledby="modalUpdateLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="modalRegistroLabel">Modificacion De Usuario</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <form id="formularioUpdate">
                        <div class="mb-3">
                            <label for="username" class="form-label">Nombre de usuario</label>
                            <input type="text" class="form-control" id="user_update" name="username" disabled>
                        </div>
                        <div class="mb-3">
                            <label for="password" class="form-label">Contraseña</label>
                            <input type="password" class="form-control" id="pass_update" name="password" required>
                        </div>
                        <div class="mb-3">
                            <label for="repeatPassword" class="form-label">Repetir Contraseña</label>
                            <input type="password" class="form-control" id="repeatPass_update" required>
                        </div>
                        <div class="mb-3">
                            <label for="rol_update" class="form-label">Rol</label>
                            <select class="form-select" id="rol_update" name="rol" required>
                                <!-- Asegúrate de llenar las opciones con los roles disponibles -->
                                <option value="2">Dentista</option>
                                <option value="3">Facturador</option>
                                <option value="4">Recepcion</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label for="status" class="form-label">Status</label>
                            <select class="form-select" id="status" name="status" required>
                                <!-- Asegúrate de llenar las opciones con los roles disponibles -->
                                <option value="1">Activo</option>
                                <option value="0">Inactivo</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label for="idEmpleado" class="form-label">ID Empleado</label>
                            <input type="text" class="form-control" id="idEmpleado_update" name="idEmpleado" disabled>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                            <button type="submit" class="btn btn-primary">Actualizar</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

</main>

@section scripts{
    <script src="~/Scripts/js/methodsDatatables.js"></script>
    <script src="~/Scripts/js/Admin/usuarios.js"></script>
}

